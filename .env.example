# Application
APP_NAME=myGYM
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mygym
DB_USERNAME=mygym_user
DB_PASSWORD=your_strong_password
DB_ROOT_PASSWORD=your_root_password

# Redis (for queues, cache, sessions)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache & Sessions
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Broadcasting (WebSockets)
BROADCAST_DRIVER=reverb
REVERB_APP_ID=mygym
REVERB_APP_KEY=your_reverb_key
REVERB_APP_SECRET=your_reverb_secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=https

# Claude AI (Anthropic)
CLAUDE_API_KEY=sk-ant-YOUR_CLAUDE_API_KEY
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096

# Mail (for notifications)
MAIL_MAILER=smtp
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_email
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Push Notifications (VAPID keys for Web Push)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Xiaomi Scale (Mi Fit API - optional)
XIAOMI_APP_TOKEN=your_xiaomi_token

# Zepp/Amazfit API
ZEPP_APP_ID=your_zepp_app_id
ZEPP_APP_SECRET=your_zepp_secret

# Frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.com

# Sanctum
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,localhost
